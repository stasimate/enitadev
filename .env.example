# LLM provider: openai | google | anthropic | ollama
ENITA_PROVIDER=openai
ENITA_MODEL=gpt-4.1-mini
# Optional model routing for each agent. Empty: the agent uses ENITA_MODEL.
ENITA_WRITER_MODEL=
ENITA_VERIFIER_MODEL=
ENITA_LLM_TIMEOUT_S=20

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

ENITA_DB_PATH=data/enita.db
ENITA_CONTENT_DIR=../content/en/topics
